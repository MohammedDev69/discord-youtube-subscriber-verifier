# ========================================================
# Discord YouTube Subscription Verifier - Configuration
# ========================================================

# [REQUIRED] Your Discord Bot Token (From Discord Developer Portal)
# https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# [OPTIONAL] Command prefix for non-slash messages (Default: !)
COMMAND_PREFIX=!

# [OPTIONAL] Default YouTube channel name to verify subscriptions for
# Can also be changed per-server using /setup channel
YOUTUBE_CHANNEL_NAME=Mohamed Hemdan

# [OPTIONAL] Default Discord role given to verified subscribers
# Can also be changed per-server using /setup role
VERIFIED_ROLE_NAME=Subscriber

# [OPTIONAL] Cooldown period in hours between verification attempts (Default: 24)
DEFAULT_COOLDOWN_HOURS=24

# [OPTIONAL] Minimum OCR confidence score required to pass (0.0 to 1.0, Default: 0.7)
DEFAULT_CONFIDENCE_THRESHOLD=0.7

# [OPTIONAL] Whether to automatically sync slash commands globally on startup (true/false)
SYNC_SLASH_COMMANDS_GLOBALLY=true

# [OPTIONAL] Custom path to Tesseract OCR executable if not found on system PATH
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
# TESSERACT_PATH=

# [OPTIONAL] Logging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

